{
  "manifest_version": 3,
  "name": "LayerGrab — Image to Layers",
  "short_name": "LayerGrab",
  "version": "0.1.0",
  "description": "Split any image on the web into editable, named layers with AI. Right-click an image, or drop one into the side panel.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open LayerGrab",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://api.layergrab.com/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "homepage_url": "https://layergrab.com/chrome-extension"
}
